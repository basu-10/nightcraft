[Unit]
Description=Nightcraft Game App (Gunicorn)
After=network.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/nightcraft-source-code/app-game
EnvironmentFile=/etc/nightcraft/app-game.env
ExecStart=/runtime/venvs/app-game/bin/python -m gunicorn \
  --workers 2 \
  --bind 127.0.0.1:5800 \
  --access-logfile - \
  --error-logfile - \
  wsgi:app
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
