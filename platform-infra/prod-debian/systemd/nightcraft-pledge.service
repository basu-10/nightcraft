[Unit]
Description=Nightcraft The Green Pledge App (Gunicorn)
After=network.target postgresql.service nightcraft-auth.service
Wants=postgresql.service

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/nightcraft-source-code/app-pledge
EnvironmentFile=/etc/nightcraft/app-pledge.env
ExecStart=/runtime/venvs/green-pledge-app/bin/python -m gunicorn \
  --workers 3 \
  --bind 127.0.0.1:5300 \
  --access-logfile - \
  --error-logfile - \
  run:app
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
