[Unit]
Description=Nightcraft Curio App (Gunicorn)
After=network.target postgresql.service nightcraft-auth.service
Wants=postgresql.service

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/platform-infra/app-artsy
EnvironmentFile=/etc/nightcraft/app-curio.env
ExecStart=/platform-infra/runtime/venvs/app-artsy/bin/gunicorn \
  --workers 2 \
  --bind 127.0.0.1:5600 \
  --access-logfile - \
  --error-logfile - \
  run:app
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
