[Unit]
Description=Nightcraft Runtime Manager (on-demand service lifecycle)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/runtime/nightcraft/manager
ExecStart=/usr/bin/python3 /opt/nightcraft/runtime-manager/nightcraft-runtime-manager.py
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
