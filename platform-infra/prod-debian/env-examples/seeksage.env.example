# app-seeksage production environment
# Copy to: /etc/nightcraft/app-seeksage.env

FLASK_ENV=production
SECRET_KEY=nightcraft-seeksage-secret-2026-prod

# SeekSage now supports local or sso auth mode.
AUTH_MODE=sso
AUTH_SERVICE_URL=http://31.70.85.89/auth
AUTHLIB_CLIENT_ID=seeksage-app
AUTHLIB_CLIENT_SECRET=seeksage-app-client-secret-2026
SSO_DEFAULT_NEXT=/

# Shared CORS origin for same-host frontend mounting.
CORS_ORIGINS=http://31.70.85.89

# Database connection.
DATABASE_URL=postgresql+psycopg://seeksage_app:change_me@127.0.0.1:5432/seeksage_db
