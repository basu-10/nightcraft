# app-pledge production environment
# Copy to: /etc/nightcraft/app-pledge.env

FLASK_SECRET_KEY=nightcraft-pledge-secret-2026-prod
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=green-pledge-app
FLASK_AUTHLIB_CLIENT_SECRET=green-pledge-app-client-secret-2026

# Shared postgres for app-pledge.
FLASK_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://green_pledge_app:green_pledge_app_db_2026_prod_secret@127.0.0.1:5432/green_pledge_db

# Optional tuning values. Keep defaults unless you need overrides.
FLASK_DEFAULT_TIMEZONE=Asia/Kolkata
