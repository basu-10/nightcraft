# app-landing production environment
# Copy to: /etc/nightcraft/app-landing.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-landing-secret-2026-prod

# Final public subpaths.
LANDING_AUTH_URL=/auth/login
LANDING_AUTH_RETURN_PARAM=next
LANDING_ADMIN_URL=/admin
LANDING_DEVRADIO_URL=/devradio
LANDING_CURIO_URL=/curio
LANDING_SEEKSAGE_URL=/seeksage
LANDING_GAME_URL=/game
