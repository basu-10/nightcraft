# app-spreadsheet (TinyXL) production environment
# Copy to: /etc/nightcraft/tinyxl.env
# Installed by install-env.sh (optional template).

FLASK_ENV=production
FLASK_SECRET_KEY=change_me_tinyxl_secret_2026

# Runtime data lives outside the source checkout (must match the
# directories created by deploy-tinyxl.sh).
TINYXL_UPLOAD_DIR=/runtime/shared/app-spreadsheet/uploads
TINYXL_DB_DIR=/runtime/shared/app-spreadsheet/db
