# service-auth production environment
# Copy to: /etc/nightcraft/service-auth.env

FLASK_ENV=production
SECRET_KEY=nightcraft-auth-secret-2026-prod
DATABASE_URL=postgresql+psycopg://auth_app:auth_app_db_2026_prod_secret@127.0.0.1:5432/auth_db

# Must match the external auth URL used by clients and browser.
OIDC_ISSUER=http://31.70.85.89/auth
PUBLIC_BASE_URL=http://31.70.85.89/auth

# Persist signing keys outside release directories.
OIDC_KEYS_DIR=/runtime/shared/service-auth/keys

# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

DEFAULT_TIMEZONE=Asia/Kolkata
