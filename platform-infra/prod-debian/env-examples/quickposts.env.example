# app-quickposts production environment
# Copy to: /etc/nightcraft/app-quickposts.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-quickposts-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.189/auth
FLASK_AUTHLIB_CLIENT_ID=quickposts-app
FLASK_AUTHLIB_CLIENT_SECRET=quickposts-app-client-secret-2026

# Database and uploads configuration.
DATABASE_URL=postgresql+psycopg://quickposts_app:change_me@127.0.0.1:5432/quickposts_db
FLASK_UPLOADS_DIR=/runtime/shared/app-quickposts/instance/uploads

# Runtime Manager keepalive (backend run-keepalive target). Must match products.yml slug.
RUNTIME_MANAGER_URL=http://127.0.0.1:5700
APP_SLUG=app-quickposts
