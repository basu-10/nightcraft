# app-note (NoteStack) production environment
# Copy to: /etc/nightcraft/app-note.env
#
# NoteStack is migrated to PostgreSQL. The deploy pipeline (deploy-note.sh)
# REQUIRES NOTESTACK_DB_BACKEND=postgres. DATABASE_URL is derived automatically
# by deploy-note.sh from the NOTESTACK_DB_* values below when it is not set
# explicitly here.

FLASK_ENV=production
SECRET_KEY=nightcraft-notestack-secret-2026-prod

# ── Database backend (PostgreSQL) ─────────────────────────────────────────────
# deploy-note.sh fails the deploy unless this is exactly "postgres".
NOTESTACK_DB_BACKEND=postgres

# DATABASE_URL is derived by deploy-note.sh from the values below unless set
# here explicitly. To override, uncomment and edit:
# DATABASE_URL=postgresql://notestack_app:CHANGE_ME@127.0.0.1:5432/notestack_db

# These MUST stay consistent with the role/db provisioned by setup-postgres.sh
# (run via the server bootstrap orchestrator). The default password below matches
# the bootstrap/setup-postgres/deploy-note defaults so a default deploy works
# out of the box. ROTATE it: set a real password here AND pass the same value to
# the bootstrap via --notestack-db-password (or let the bootstrap write DATABASE_URL
# directly), otherwise the app cannot authenticate to PostgreSQL.
NOTESTACK_DB_NAME=notestack_db
NOTESTACK_DB_USER=notestack_app
NOTESTACK_DB_PASSWORD=notestack_app_db_2026_prod_secret

# ── Auth (local or sso) ───────────────────────────────────────────────────────
# NoteStack supports a local sign-in system or central SSO via service-auth.
AUTH_MODE=local
AUTH_SERVICE_URL=http://31.70.85.89/auth
AUTH_SESSION_ME_URL=http://31.70.85.89/auth/api/session/me

# Shared CORS origin for same-host frontend mounting.
CORS_ORIGINS=http://31.70.85.89
