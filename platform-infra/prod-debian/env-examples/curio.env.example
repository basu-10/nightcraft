# app-curio production environment
# Copy to: /etc/nightcraft/app-curio.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-curio-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=curio-app
FLASK_AUTHLIB_CLIENT_SECRET=curio-app-client-secret-2026

# Optional db and uploads overrides.
FLASK_SQLALCHEMY_DATABASE_URI=sqlite:////platform-infra/runtime/shared/app-artsy/instance/curio.db
FLASK_UPLOADS_DIR=/platform-infra/runtime/shared/app-artsy/instance/uploads/works
