# app-noteflow production environment
# Copy to: /etc/nightcraft/app-noteflow.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-noteflow-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=noteflow-app
FLASK_AUTHLIB_CLIENT_SECRET=noteflow-app-client-secret-2026

# Database and uploads configuration.
DATABASE_URL=postgresql+psycopg://noteflow_app:noteflow_app_db_2026_prod_secret@127.0.0.1:5432/noteflow_db
FLASK_UPLOADS_DIR=/runtime/shared/app-noteflow/instance/uploads

# Runtime Manager keepalive (backend run-keepalive target). Must match products.yml slug.
RUNTIME_MANAGER_URL=http://127.0.0.1:5700
APP_SLUG=app-noteflow
