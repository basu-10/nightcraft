# app-scratchpad production environment
# Copy to: /etc/nightcraft/app-scratchpad.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-scratchpad-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=scratchpad-app
FLASK_AUTHLIB_CLIENT_SECRET=scratchpad-app-client-secret-2026

# Database and uploads configuration.
DATABASE_URL=postgresql+psycopg://scratchpad_app:scratchpad_app_db_2026_prod_secret@127.0.0.1:5432/scratchpad_db
FLASK_UPLOADS_DIR=/runtime/shared/app-scratchpad/instance/uploads

# Runtime Manager keepalive (backend run-keepalive target). Must match products.yml slug.
RUNTIME_MANAGER_URL=http://127.0.0.1:5700
APP_SLUG=app-scratchpad
