# app-radio production environment
# Copy to: /etc/nightcraft/app-radio.env

FLASK_SECRET_KEY=nightcraft-radio-secret-2026-prod
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=radio-app
FLASK_AUTHLIB_CLIENT_SECRET=radio-app-client-secret-2026

# Shared postgres for app-radio.
FLASK_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://radio_app:radio_app_db_2026_prod_secret@127.0.0.1:5432/radio_db

# Optional tuning values. Keep defaults unless you need overrides.
FLASK_DEFAULT_TIMEZONE=Asia/Kolkata
FLASK_AUTOMATED_BACKGROUND_ENABLED=true
FLASK_AUTOMATED_INGEST_INTERVAL_SECONDS=3600
FLASK_SOURCE_FETCH_ENABLED=true
FLASK_SOURCE_FETCH_EXTRACT_IMAGES=true
FLASK_ARTICLE_IMAGES_ENABLED=true
