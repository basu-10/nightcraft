# app-game production environment
# Copy to: /etc/nightcraft/app-game.env
# Installed by install-env.sh (optional template).

FLASK_ENV=production
FLASK_SECRET_KEY=change_me_game_secret_2026

# PvP matchmaking/rooms use Redis.
REDIS_URL=redis://127.0.0.1:6379/0

# SSO auth via the shared OIDC service. AUTH_MODE must be "sso" for real login.
AUTH_MODE=sso
AUTH_SERVICE_URL=http://31.70.85.89/auth
OIDC_CLIENT_ID=game-app
OIDC_CLIENT_SECRET=game-app-client-secret-2026
OIDC_REDIRECT_URI=http://31.70.85.89/game/auth/callback

# Persistent shared volume for emulator ROM storage + metadata DB.
GAME_SHARED_DIR=/runtime/shared/app-game

# EmulatorJS ROM upload limits.
GAME_MAX_UPLOAD_MB=64
GAME_EMULATOR_MAX_ROMS=20
GAME_EMULATOR_MAX_STORAGE_MB=512

# Comma-separated user IDs permitted to remove any ROM (DMCA takedowns).
# GAME_ADMIN_USER_IDS=
