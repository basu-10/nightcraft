# app-neera production environment
# Copy to: /etc/nightcraft/app-neera.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-neera-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.89/auth
FLASK_AUTHLIB_CLIENT_ID=neera-app
FLASK_AUTHLIB_CLIENT_SECRET=neera-app-client-secret-2026

# Database and uploads configuration.
DATABASE_URL=postgresql+psycopg://neera_app:neera_app_db_2026_prod_secret@127.0.0.1:5432/neera_db
FLASK_UPLOADS_DIR=/runtime/shared/app-artsy/instance/uploads/works
