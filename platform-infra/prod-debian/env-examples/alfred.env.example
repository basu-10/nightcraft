# app-alfred production environment
# Copy to: /etc/nightcraft/app-alfred.env

FLASK_ENV=production
FLASK_SECRET_KEY=nightcraft-alfred-secret-2026-prod

# Enable shared auth mode.
FLASK_AUTH_MODE=sso
FLASK_AUTH_SERVICE_URL=http://31.70.85.189/auth
FLASK_AUTHLIB_CLIENT_ID=alfred-app
FLASK_AUTHLIB_CLIENT_SECRET=alfred-app-client-secret-2026

# OpenRouter (env fallback; the active key is set by an admin in AppSetting).
OPENROUTER_API_KEY=

# Database and uploads configuration.
DATABASE_URL=postgresql+psycopg://alfred_app:change_me@127.0.0.1:5432/alfred_db
FLASK_UPLOADS_DIR=/runtime/shared/app-alfred/instance/uploads

# Runtime Manager keepalive (backend run-keepalive target). Must match products.yml slug.
RUNTIME_MANAGER_URL=http://127.0.0.1:5700
APP_SLUG=alfred
